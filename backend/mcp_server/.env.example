# Hermes MCP server example environment. Copy to mcp_server/.env and adjust.
# All variables use the HERMES_MCP_ prefix.

# FastAPI backend base URL. Must be http or https and include a host.
# For local development the backend runs on port 8000.
HERMES_MCP_BACKEND_BASE_URL=http://127.0.0.1:8000

# Development auth user id forwarded to the backend via the X-Hermes-Dev-User
# header. This reuses the backend's existing dev authentication adapter and is
# NOT production authentication. Never set this from an LLM tool argument.
HERMES_MCP_DEV_USER_ID=usr_01

# Whether to send the dev-user header at all. Set to false to rely on the
# backend's configured default demo user.
HERMES_MCP_SEND_DEV_USER_HEADER=true

# HTTP client timeouts in seconds.
HERMES_MCP_CONNECT_TIMEOUT=5.0
HERMES_MCP_READ_TIMEOUT=15.0

# Maximum client-side pagination size (mirrors the backend max of 100).
HERMES_MCP_MAX_PAGE_SIZE=100

# Authorization tool toggle. DISABLED by default. Even when enabled, the
# backend enforces simulation-only safety; this flag only controls MCP exposure.
HERMES_MCP_ENABLE_AUTHORIZE_TOOL=false
