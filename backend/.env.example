# Hermes backend example environment. Copy to .env and adjust as needed.

# Database file location (relative to the backend data dir). A persistent
# SQLite file is used by default; data survives restarts.
HERMES_DB_PATH=data/hermes.db

# Reporting timezone for calendar-month filtering and display. IANA name.
HERMES_REPORTING_TIMEZONE=Asia/Kolkata

# CORS: comma-separated list of allowed origins for the dev server.
HERMES_CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081

# Development auth: the demo user id resolved when no real identity provider is
# attached. This is NOT production authentication.
HERMES_DEV_USER_ID=usr_01

# Seed dataset sizing. Defaults target a substantial local dataset.
HERMES_SEED_USERS=1000
HERMES_SEED_ACCOUNTS_MIN=1000
HERMES_SEED_ACCOUNTS_MAX=1500
HERMES_SEED_BENEFICIARIES=5000
HERMES_SEED_TRANSACTIONS=100000

# Transfer approval TTL in seconds (5 minutes).
HERMES_APPROVAL_TTL_SECONDS=300
